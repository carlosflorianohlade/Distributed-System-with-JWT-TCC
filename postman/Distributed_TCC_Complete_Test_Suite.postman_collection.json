              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"p2\",\n  \"quantity\": 1,\n  \"address\": \"Via Roma 1\",\n  \"fail_payment\": false,\n  \"fail_shipping\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order success 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Decision COMMIT\", () => pm.expect(body.decision).to.eql(\"COMMIT\"));",
                  "pm.test(\"Order confirmed\", () => pm.expect(body.status).to.eql(\"ORDER_CONFIRMED\"));",
                  "pm.test(\"All confirms OK\", () => {",
                  "  [\"inventory\",\"payment\",\"shipping\"].forEach(p => {",
                  "    pm.expect(body.participants[p].try).to.eql(\"OK\");",
                  "    pm.expect(body.participants[p].confirm).to.eql(\"OK\");",
                  "  });",
                  "});",
                  "pm.collectionVariables.set(\"lastOrderId\", body.transaction_id);"
                ]
              }
            }
          ],
          "name": "Ordine riuscito - COMMIT"
        },
        {
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
