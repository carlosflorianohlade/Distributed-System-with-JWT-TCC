              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"p2\",\n  \"quantity\": 1,\n  \"address\": \"Via Roma 1\",\n  \"fail_payment\": true,\n  \"fail_shipping\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment failure returns error\", () => pm.expect(pm.response.code).to.be.oneOf([409,500,503]));",
                  "const body = pm.response.json();",
                  "pm.test(\"Rollback decision\", () => pm.expect(body.detail.decision).to.eql(\"ROLLBACK\"));",
                  "pm.test(\"Final status cancelled or pending\", () => pm.expect(body.detail.status).to.be.oneOf([\"CANCELLED\",\"CANCEL_PENDING\"]));",
                  "pm.collectionVariables.set(\"lastOrderId\", body.detail.transaction_id);"
                ]
              }
            }
          ],
          "name": "Ordine con errore payment - ROLLBACK"
