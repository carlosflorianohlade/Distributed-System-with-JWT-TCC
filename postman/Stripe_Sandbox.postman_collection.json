    {
      "name": "02 - Payment diretto",
      "item": [
        {
          "name": "Try (pm_card_visa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/tcc/try",
              "host": [
                "{{paymentBaseUrl}}"
              ],
              "path": [
                "tcc",
                "try"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{stripeTx}}\",\n  \"username\": \"carlos\",\n  \"amount\": 49.9,\n  \"payment_method\": \"pm_card_visa\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('stripeTx','stripe-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"RESERVED\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('RESERVED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Try identico - idempotenza",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/tcc/try",
              "host": [
                "{{paymentBaseUrl}}"
              ],
              "path": [
                "tcc",
                "try"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"{{stripeTx}}\",\n  \"username\": \"carlos\",\n  \"amount\": 49.9,\n  \"payment_method\": \"pm_card_visa\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ALREADY_PROCESSED\", () => { pm.expect(pm.response.json().status).to.eql('ALREADY_PROCESSED'); });"
                ]
              }
            }
          ]
        },
