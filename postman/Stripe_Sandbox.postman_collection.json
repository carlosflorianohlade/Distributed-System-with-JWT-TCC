{
  "info": {
    "name": "Stripe Sandbox - Order + Payment TCC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Flusso ordine con Stripe",
      "item": [
        {
          "name": "Payment health (mode)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/health",
              "host": [
                "{{paymentBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Stripe sandbox\", () => { pm.expect(pm.response.json().mode).to.eql('stripe-sandbox'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - salva token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authBaseUrl}}/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"carlos\",\n  \"password\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 + token\", () => { pm.response.to.have.status(200); pm.collectionVariables.set('token', pm.response.json().access_token); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ordine COMMIT - Stripe authorize + capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"p2\",\n  \"quantity\": 1,\n  \"address\": \"Via Roma 1\",\n  \"payment_method\": \"pm_card_visa\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ORDER_CONFIRMED\", () => { const b=pm.response.json(); pm.response.to.have.status(200); pm.expect(b.status).to.eql('ORDER_CONFIRMED'); pm.expect(b.decision).to.eql('COMMIT'); });",
                  "pm.test(\"PaymentIntent Stripe\", () => { const b=pm.response.json(); pm.expect(b.payment_intent_id).to.match(/^pi_/); pm.collectionVariables.set('paymentIntentId', b.payment_intent_id); pm.collectionVariables.set('lastOrderId', b.transaction_id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verifica pagamento CONFIRMED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/state",
              "host": [
                "{{paymentBaseUrl}}"
              ],
              "path": [
                "state"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Stato CONFIRMED\", () => { const p=pm.response.json().payments[pm.collectionVariables.get('lastOrderId')]; pm.expect(p.state).to.eql('CONFIRMED'); pm.expect(p.payment_intent_id).to.eql(pm.collectionVariables.get('paymentIntentId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ordine con carta rifiutata - ROLLBACK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"p2\",\n  \"quantity\": 1,\n  \"address\": \"Via Roma 1\",\n  \"payment_method\": \"pm_card_chargeDeclined\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 + ROLLBACK\", () => { const b=pm.response.json(); pm.response.to.have.status(409); pm.expect(b.detail.decision).to.eql('ROLLBACK'); pm.expect(b.detail.failed_participant).to.eql('payment'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ordine con errore shipping - ROLLBACK (Stripe cancel)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{orderBaseUrl}}/orders",
              "host": [
                "{{orderBaseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"p2\",\n  \"quantity\": 1,\n  \"address\": \"Via Roma 1\",\n  \"payment_method\": \"pm_card_visa\",\n  \"fail_shipping\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ROLLBACK\", () => { const b=pm.response.json(); pm.expect(b.detail.decision).to.eql('ROLLBACK'); pm.collectionVariables.set('lastOrderId', b.detail.transaction_id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verifica pagamento CANCELLED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentBaseUrl}}/state",
              "host": [
                "{{paymentBaseUrl}}"
              ],
              "path": [
                "state"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Stato CANCELLED\", () => { const p=pm.response.json().payments[pm.collectionVariables.get('lastOrderId')]; pm.expect(p.state).to.eql('CANCELLED'); });"
                ]
              }
            }
          ]
        }
      ]
    },
